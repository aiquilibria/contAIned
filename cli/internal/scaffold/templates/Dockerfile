# syntax=docker/dockerfile:1.4
FROM python:3.13-slim

# Install runtimes and tools the agent may legitimately use
RUN apt-get update && apt-get install -y --no-install-recommends \
    nodejs npm git curl bash ca-certificates \
    bubblewrap socat \
    && rm -rf /var/lib/apt/lists/*

# Install sandbox-runtime for seccomp filter support.
# Update the pinned version here to upgrade.
RUN npm install -g @anthropic-ai/sandbox-runtime@0.0.42

# Install a pinned Claude Code binary directly from the distribution bucket.
# install.sh always bootstraps with the latest binary regardless of the version
# argument, so we bypass it and fetch from the versioned GCS path directly.
# Update CLAUDE_CODE_VERSION here to upgrade; override at build time with
#   --build-arg CLAUDE_CODE_VERSION=x.y.z
ARG CLAUDE_CODE_VERSION=2.1.89
RUN set -eux; \
    ARCH=$(uname -m); \
    [ "$ARCH" = "x86_64" ] && ARCH=x64; \
    [ "$ARCH" = "aarch64" ] && ARCH=arm64; \
    GCS="https://storage.googleapis.com/claude-code-dist-86c565f3-f756-42ad-8dfa-d59b1c096819/claude-code-releases"; \
    PLATFORM="linux-${ARCH}"; \
    CHECKSUM=$(curl -fsSL --retry 3 --retry-delay 5 "${GCS}/${CLAUDE_CODE_VERSION}/manifest.json" \
        | python3 -c "import sys,json; print(json.load(sys.stdin)['platforms']['${PLATFORM}']['checksum'])"); \
    mkdir -p /opt/claude-code; \
    curl -fsSL --retry 3 --retry-delay 5 -o /opt/claude-code/claude "${GCS}/${CLAUDE_CODE_VERSION}/${PLATFORM}/claude"; \
    echo "${CHECKSUM}  /opt/claude-code/claude" | sha256sum -c -; \
    chmod 755 /opt/claude-code/claude

# Install declared toolchains (go, node, ruby, java).
# toolchains.sh is generated by `contained init` from the merged manifest.
COPY toolchains.sh /tmp/toolchains.sh
RUN chmod +x /tmp/toolchains.sh && /tmp/toolchains.sh && rm /tmp/toolchains.sh

# Install declared ecosystem deps (e.g. golangci-lint).
# deps.sh is generated by `contained init` from the merged manifest.
COPY deps.sh /tmp/deps.sh
RUN chmod +x /tmp/deps.sh && /tmp/deps.sh && rm /tmp/deps.sh

# Install uv for fast venv + package installation (build-time only).
# Update the pinned tag here to upgrade.
COPY --from=ghcr.io/astral-sh/uv:0.11.1 /uv /usr/local/bin/uv

# Install contAIned into an isolated venv so it never contaminates the
# workspace Python environment, regardless of what the agent installs.
# The source tree is embedded in the contained binary and written to the
# build context by `contained init`, so no PyPI dependency is needed.
COPY --chown=root:root pyproject.toml /opt/contAIned/pyproject.toml
COPY --chown=root:root src/ /opt/contAIned/src/
RUN uv venv --python python3.13 /opt/contained-venv \
    && uv pip install --python /opt/contained-venv/bin/python3 --no-cache /opt/contAIned[dev]

# Set up in-container runtime paths
# /tmp/claude is created here because the Claude Code sandbox sets TMPDIR to
# this path for Bash subprocesses. Without the directory existing the Go
# toolchain (and any other tool that calls os.TempDir) cannot create work files.
RUN mkdir -p /etc/claude-code /etc/contained /run/contained /tmp/claude \
    && chmod 1777 /tmp/claude

# Copy the Claude Code plugin and statusline to fixed paths so the entrypoint
# can reference them without knowing the Python package install location.
RUN /opt/contained-venv/bin/python3 -c "\
import os, shutil, contained; \
pkg = os.path.dirname(contained.__file__); \
shutil.copy(os.path.join(pkg, 'runtime', 'statusline.py'), '/etc/contained/statusline.py'); \
shutil.copytree(os.path.join(pkg, 'runtime', 'plugin'), '/etc/contained/plugin') \
"

# Bake managed-settings.json into the image.
# MANAGED_SETTINGS_CONTENT must be passed as a base64-encoded build arg by
# contained init — direct docker build invocations are not supported.
ARG MANAGED_SETTINGS_CONTENT
RUN test -n "$MANAGED_SETTINGS_CONTENT" \
    || { echo "ERROR: MANAGED_SETTINGS_CONTENT build arg is required. Use contained init to build this image."; exit 1; } \
    && echo "$MANAGED_SETTINGS_CONTENT" | base64 -d > /etc/claude-code/managed-settings.json

# Bake the contAIned operating instructions into the managed CLAUDE.md.
# Claude Code loads /etc/claude-code/CLAUDE.md alongside the project's
# ./CLAUDE.md — they compose automatically. The operator is free to use
# ./CLAUDE.md for project-specific instructions without conflict.
# CLAUDE_MD_CONTENT must be passed as a base64-encoded build arg by contained init.
ARG CLAUDE_MD_CONTENT
RUN test -n "$CLAUDE_MD_CONTENT" \
    || { echo "ERROR: CLAUDE_MD_CONTENT build arg is required. Use contained init to build this image."; exit 1; } \
    && echo "$CLAUDE_MD_CONTENT" | base64 -d > /etc/claude-code/CLAUDE.md

# Bake the operator manifest into the image so hooks read policy from
# /etc/contained/manifest.yaml rather than the workspace.
# Validate the manifest policy rules in blocking mode (phase 2): validation
# errors abort the build so operators catch policy mistakes before deployment.
ARG MANIFEST_CONTENT=""
RUN if [ -n "$MANIFEST_CONTENT" ]; then \
        echo "$MANIFEST_CONTENT" | base64 -d > /etc/contained/manifest.yaml \
        && /opt/contained-venv/bin/python3 -m contained.engine.validate_manifest \
               /etc/contained/manifest.yaml; \
    fi

# Write the in-container entrypoint script.
# Reads agent.model from the workspace manifest and execs claude directly.
RUN cat <<'ENTRYPOINT_EOF' > /etc/contained/entrypoint.sh
#!/bin/sh
# If the workspace ships a src/ tree (e.g. the contAIned repo itself), prefer
# it over the image-baked package so hook changes take effect without rebuilding.
[ -d /workspace/src ] && export PYTHONPATH="/workspace/src${PYTHONPATH:+:$PYTHONPATH}"
MODEL=$(/opt/contained-venv/bin/python3 -c "
import yaml, sys
try:
    m = yaml.safe_load(open('/workspace/.contAIned/manifest.yaml'))
    print(m.get('agent', {}).get('model', ''))
except Exception:
    pass
" 2>/dev/null)
# Export extra_secrets into the environment. Each secret is mounted read-only
# at /run/contained/secrets-env/<VAR_NAME> by the runner; exporting here keeps
# values out of docker run args and docker inspect output.
for _f in /run/contained/secrets-env/*; do
    [ -f "$_f" ] || continue
    export "$(basename "$_f")=$(cat "$_f")"
done
CMD="claude --plugin-dir /etc/contained/plugin"
[ -n "$MODEL" ] && CMD="$CMD --model $MODEL"
# Write ~/.netrc entries for git/curl HTTPS auth from already-exported secrets.
# Each line in netrc-from-secrets.txt is "machine:ENV_VAR"; the env var was
# exported above from /run/contained/secrets-env/ so its value is available now.
if [ -f /etc/contained/netrc-from-secrets.txt ]; then
    while IFS=: read -r _machine _env_var || [ -n "$_machine" ]; do
        [ -z "$_machine" ] || [ -z "$_env_var" ] && continue
        eval "_secret_val=\"\${${_env_var}:-}\""
        if [ -n "$_secret_val" ]; then
            printf 'machine %s login x-token password %s\n' "$_machine" "$_secret_val" >> ~/.netrc
        fi
    done < /etc/contained/netrc-from-secrets.txt
    chmod 600 ~/.netrc 2>/dev/null || true
fi
# Restore pre-installed marketplace files into the host-mounted ~/.claude/plugins
# so that plugin commands can resolve sources even before registration completes.
# cp -rn is purely additive and never overwrites files the user already has.
if [ -d /opt/contained-plugins-preinstalled ]; then
    mkdir -p /home/agent/.claude/plugins
    cp -rn /opt/contained-plugins-preinstalled/. /home/agent/.claude/plugins/ 2>/dev/null || true
fi
# Register pre-configured plugins into ~/.claude.json (the host-mounted settings
# file that drives `claude plugin list`). A content-hash marker file ensures this
# only runs when the plugin set changes, keeping subsequent startups fast.
if [ -f /etc/contained/preinstall-plugins.txt ]; then
    HASH=$(md5sum /etc/contained/preinstall-plugins.txt 2>/dev/null | cut -d' ' -f1 || echo "unknown")
    MARKER="/home/agent/.claude/plugins/.contained-plugins-$HASH"
    if [ ! -f "$MARKER" ]; then
        while IFS=: read -r mp plugin || [ -n "$mp" ]; do
            [ -z "$mp" ] || [ -z "$plugin" ] && continue
            /opt/claude-code/claude --dangerously-skip-permissions plugin install "$plugin@$mp" >/dev/null 2>&1 || true
        done < /etc/contained/preinstall-plugins.txt
        touch "$MARKER" 2>/dev/null || true
    fi
fi
exec $CMD "$@"
ENTRYPOINT_EOF
RUN chmod +x /etc/contained/entrypoint.sh

# Create a non-root user whose UID/GID matches the host operator.
ARG HOST_UID=1000
ARG HOST_GID=1000
RUN if getent group $HOST_GID >/dev/null 2>&1; then \
        existing_group=$(getent group $HOST_GID | cut -d: -f1); \
        useradd -m -u $HOST_UID -g $existing_group -s /bin/bash agent; \
    else \
        groupadd -g $HOST_GID agent \
        && useradd -m -u $HOST_UID -g $HOST_GID -s /bin/bash agent; \
    fi

# Give the agent user a ~/.local/bin so the Claude Code self-check passes.
RUN mkdir -p /home/agent/.local/bin \
    && ln -s /opt/claude-code/claude /home/agent/.local/bin/claude \
    && chown -R agent /home/agent/.local

ENV PATH="/opt/contained-venv/bin:/home/agent/.local/bin:/opt/claude-code:/usr/local/go/bin:/usr/local/ruby/bin:$PATH"

USER agent

# Marketplace repos are pre-cloned on the host by contained init (git clone +
# external_plugins/ → plugins/ merge) and injected via the build context.
# known_marketplaces.json maps name → source/installLocation for Claude Code.
COPY --chown=agent:agent marketplaces/ /home/agent/.claude/plugins/marketplaces/
COPY --chown=agent:agent known_marketplaces.json /home/agent/.claude/plugins/known_marketplaces.json

# Pre-install plugins baked into the image at contained init time.
# PLUGINS_TO_INSTALL is a base64-encoded newline-delimited list of
# "marketplace:plugin" pairs collected from policy.plugins.preinstall and
# active ecosystem_definitions[*].plugins in the operator manifest.
#
ARG PLUGINS_TO_INSTALL=""
RUN if [ -n "$PLUGINS_TO_INSTALL" ]; then \
        echo "$PLUGINS_TO_INSTALL" | base64 -d | \
        while IFS=: read -r mp plugin; do \
            if output=$(/opt/claude-code/claude --dangerously-skip-permissions \
                    plugin install "$plugin@$mp" 2>&1); then \
                echo "[contained] Installed $plugin@$mp"; \
            else \
                echo "[contained] FAILED: $plugin@$mp"; \
                echo "$output" | while IFS= read -r errline; do \
                    echo "[contained]   $errline"; \
                done; \
            fi; \
        done; \
    fi

# Snapshot the pre-installed plugin state to /opt so the entrypoint can
# restore it after the host's ~/.claude directory is bind-mounted at runtime
# (which shadows everything written to ~/.claude during docker build).
USER root
RUN cp -rp /home/agent/.claude/plugins /opt/contained-plugins-preinstalled
# Write the decoded plugin list so the entrypoint can re-register plugins into
# the host-mounted ~/.claude.json at first container start.
RUN if [ -n "$PLUGINS_TO_INSTALL" ]; then \
        echo "$PLUGINS_TO_INSTALL" | base64 -d > /etc/contained/preinstall-plugins.txt; \
    fi
# Bake the netrc-from-secrets mapping so the entrypoint can generate ~/.netrc
# entries for git/curl HTTPS auth from already-exported extra_secrets.
# NETRC_FROM_SECRETS is a base64-encoded newline-delimited "machine:ENV_VAR" list.
ARG NETRC_FROM_SECRETS=""
RUN if [ -n "$NETRC_FROM_SECRETS" ]; then \
        echo "$NETRC_FROM_SECRETS" | base64 -d > /etc/contained/netrc-from-secrets.txt; \
    fi
USER agent

# Trust /workspace regardless of host UID/GID ownership
RUN git config --global --add safe.directory /workspace

WORKDIR /workspace

ENTRYPOINT ["/etc/contained/entrypoint.sh"]
