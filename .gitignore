# ── contAIned — control plane ─────────────────────────────────────────────────────
# The .contAIned/ directory contains hooks, policy, and audit logs managed by contAIned.
# Keep it out of version control.
.contAIned/
.slash/
docs/internal/
.claude/*
pytest-of-agent*

# ── contAIned — container-injected dotfiles ───────────────────────────────────
# Empty stub files written by the contAIned runtime at container start.
.bash_profile
.bashrc
.gitconfig
.gitmodules
.mcp.json
.profile
.ripgreprc
.zprofile
.zshrc